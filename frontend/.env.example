# Local / Docker
BACKEND_URL=http://127.0.0.1:4000
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MINIMUM_32_CHARACTERS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Optionnel — proxy navigateur (sinon rewrite Next → BACKEND_URL)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Universal links / App Links mobile
# Apple Developer Team ID utilisé par l'app iOS (ex. ABCDE12345)
APPLE_TEAM_ID=
# Empreinte SHA-256 du certificat de signature Android. Plusieurs empreintes peuvent être séparées par des virgules.
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=
