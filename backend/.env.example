NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mastercota:CHANGE_ME@localhost:5432/mastercota
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MINIMUM_32_CHARACTERS
APP_URL=http://localhost:3000
# Paiements des frais Mastercota. PI-SPI devient principal uniquement apres configuration d'un participant homologue.
PLATFORM_PAYMENT_PRIMARY=paystack
PISPI_ENABLED=false
PISPI_PARTICIPANT=
PISPI_API_BASE_URL=
PISPI_CLIENT_ID=
PISPI_CLIENT_SECRET=
# Secours explicite; ne jamais lancer automatiquement apres un echec PI-SPI.
PAYSTACK_SECRET_KEY=
OPENWA_ENABLED=false
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Local uniquement, code émis après send-otp (jamais accepté en production).
OTP_DEV_CODE=123456
ADMIN_PHONES=
TRUST_PROXY=false
