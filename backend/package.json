{
  "name": "mastercota-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
